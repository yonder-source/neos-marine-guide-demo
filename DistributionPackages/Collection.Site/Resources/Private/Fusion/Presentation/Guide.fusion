prototype(Collection.Site:Presentation.Guide) < prototype(Neos.Fusion:Component) {
  data = ${MarineGuide.content(node)}
  audienceItems = Neos.Neos:DimensionsMenuItems {
    dimension = 'audience'
    presets = ${['children', 'adult', 'expert']}
  }
  id = ${'marine-' + node.aggregateId.value}
  imageUri = Collection.Site:Presentation.GuideImageUri
  renderer = afx`
    <article class="guide" data-guide data-audience={props.data.audience} data-language={MarineGuide.language(documentNode)} id={props.id}
      data-deck-previous={MarineGuide.label('deck.previous', documentNode)}
      data-deck-next={MarineGuide.label('deck.next', documentNode)}
      data-deck-home={MarineGuide.label('deck.home', documentNode)}
      data-deck-cover={MarineGuide.label('deck.cover', documentNode)}
      data-deck-observe={MarineGuide.label('deck.observe', documentNode)}
      data-deck-story={MarineGuide.label('deck.story', documentNode)}
      data-deck-quiz={MarineGuide.label('deck.quiz', documentNode)}
      data-deck-actions={MarineGuide.label('deck.actions', documentNode)}
      data-deck-sources={MarineGuide.label('deck.sources', documentNode)}
      data-deck-more={MarineGuide.label('deck.more', documentNode)}
      data-deck-navigation={MarineGuide.label('deck.navigation', documentNode)}
    >
      <header class="guide-heading">
        <div><p class="eyebrow">FIELD NOTES / 01 <span>{String.htmlSpecialChars(props.data.category)}</span></p><h2>{String.htmlSpecialChars(props.data.guideTitle)}</h2></div>
        <p class="reading-time"><span aria-hidden="true">◷</span> <Collection.Site:Presentation.Label labelKey="duration.before" /> {String.htmlSpecialChars(props.data.duration)} <Collection.Site:Presentation.Label labelKey="duration.after" /></p>
      </header>
      <nav class="audience-switch" data-audience-switch aria-label={MarineGuide.label('audience.label', documentNode)}>
        <Neos.Fusion:Loop items={props.audienceItems} itemName="audienceItem">
          <a @if.available={audienceItem.uri} href={audienceItem.uri} data-audience={audienceItem.targetDimensions.audience.value} aria-current={audienceItem.targetDimensions.audience.value == props.data.audience ? 'page' : null}>
            <span class="audience-number">{audienceItem.targetDimensions.audience.value == 'children' ? '01' : audienceItem.targetDimensions.audience.value == 'adult' ? '02' : '03'}</span>
            <span><strong><Collection.Site:Presentation.Label labelKey={audienceItem.targetDimensions.audience.value + '.name'} /></strong><small><Collection.Site:Presentation.Label labelKey={audienceItem.targetDimensions.audience.value + '.hint'} /></small></span><span class="tab-arrow" aria-hidden="true">↗</span>
          </a>
        </Neos.Fusion:Loop>
      </nav>
      <div class="guide-layout">
        <div class="observation">
          <figure class="observation-figure">
            <div class="observation-image">
              <img src={props.imageUri} alt={props.data.imageAlt} width="1280" height="890" loading="lazy" />
              <span class="photo-label"><Collection.Site:Presentation.Label labelKey="photo.hint" /></span>
              <button class="hotspot hotspot-one" type="button" data-hotspot="one" style={'--spot-x: ' + props.data.observationOneX + '%; --spot-y: ' + props.data.observationOneY + '%'} aria-controls={props.id + '-observation-one'} aria-expanded="false" aria-label={props.data.observationOneTitle} hidden>1</button>
              <button class="hotspot hotspot-two" type="button" data-hotspot="two" style={'--spot-x: ' + props.data.observationTwoX + '%; --spot-y: ' + props.data.observationTwoY + '%'} aria-controls={props.id + '-observation-two'} aria-expanded="false" aria-label={props.data.observationTwoTitle} hidden>2</button>
            </div>

          </figure>
          <div class="observation-notes">
            <details id={props.id + '-observation-one'} data-observation="one"><summary><span>01</span>{String.htmlSpecialChars(props.data.observationOneTitle)}</summary><p>{String.htmlSpecialChars(props.data.observationOneBody)}</p></details>
            <details id={props.id + '-observation-two'} data-observation="two"><summary><span>02</span>{String.htmlSpecialChars(props.data.observationTwoTitle)}</summary><p>{String.htmlSpecialChars(props.data.observationTwoBody)}</p></details>
          </div>
          <p class="conservation-status" @if.hasStatus={props.data.conservationStatus}>{String.htmlSpecialChars(props.data.conservationStatus)}</p>
          <dl class="specimen-facts"><div><dt><Collection.Site:Presentation.Label labelKey="facts.name" /></dt><dd>{String.htmlSpecialChars(props.data.commonName)}</dd></div><div><dt><Collection.Site:Presentation.Label labelKey="facts.scientific" /></dt><dd><i>{String.htmlSpecialChars(props.data.scientificName)}</i></dd></div><div><dt><Collection.Site:Presentation.Label labelKey="facts.habitat" /></dt><dd>{String.htmlSpecialChars(props.data.habitat)}</dd></div></dl>
        </div>
        <div class="audience-panels">
          <section class="audience-panel" data-audience-panel={props.data.audience} id={props.id + '-audience'} aria-labelledby={props.id + '-heading-audience'}>
            <p class="panel-label"><Collection.Site:Presentation.Label labelKey={props.data.audience + '.panel'} /></p><h3 id={props.id + '-heading-audience'}>{String.htmlSpecialChars(props.data.audienceTitle)}</h3><p class="guide-story">{String.htmlSpecialChars(props.data.audienceBody)}</p>
            <img class="children-illustration" src={StaticResource.uri('Collection.Site', 'Public/Images/hawksbill-buddy.svg')} alt="" aria-hidden="true" loading="lazy" @if.forChildren={props.data.audience == 'children'} />
            <Collection.Site:Presentation.Actions id={props.id} items={props.data.actions} />
            <Collection.Site:Presentation.Evidence id={props.id} metrics={props.data.metrics} items={props.data.evidence} updated={props.data.evidenceUpdated} />
            <Collection.Site:Presentation.Quiz id={props.id + '-quiz'} question={props.data.audienceQuestion} optionA={props.data.audienceOptionA} optionB={props.data.audienceOptionB} optionC={props.data.audienceOptionC} correct={props.data.audienceCorrect} explanation={props.data.audienceExplanation} audience={props.data.audience} />
          </section>
        </div>
      </div>
      <aside class="followup"><span class="followup-icon" aria-hidden="true">＋</span><div><p class="eyebrow">KEEP WONDERING <span><Collection.Site:Presentation.Label labelKey="followup" /></span></p><details><summary>{String.htmlSpecialChars(props.data.followupQuestion)}</summary><p>{String.htmlSpecialChars(props.data.followupAnswer)}</p></details></div></aside>
      <section class="sources" id={props.id + '-sources'} aria-labelledby={props.id + '-sources-heading'}>
        <h3 id={props.id + '-sources-heading'}><Collection.Site:Presentation.Label labelKey="sources.title" /></h3>
        <div><a href={props.data.sourceUrl} @if.hasSource={props.data.sourceUrl}>{String.htmlSpecialChars(props.data.sourceTitle)} ↗</a><a href={props.data.speciesSourceUrl} @if.hasSpeciesSource={props.data.speciesSourceUrl}>{String.htmlSpecialChars(props.data.speciesSourceTitle)} ↗</a><a href={props.data.imageSourceUrl} @if.hasCredit={props.data.imageSourceUrl}><Collection.Site:Presentation.Label labelKey="sources.image" /> · {String.htmlSpecialChars(props.data.imageCredit)} ↗</a><a href={props.data.imageLicenseUrl} @if.hasLicense={props.data.imageLicenseUrl}><Collection.Site:Presentation.Label labelKey="image.license" /> ↗</a><p><Collection.Site:Presentation.Label labelKey="sources.note" /></p></div>
      </section>
    </article>
  `
}
